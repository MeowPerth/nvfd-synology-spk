#!/bin/sh
SPM=/usr/local/bin/spm-exec
if [ -x "$SPM" ]; then
    "$SPM" /bin/sh -c '
        timeout 20 systemctl stop nvfd >/dev/null 2>&1 || true
        systemctl disable nvfd >/dev/null 2>&1 || true
        rm -f /etc/systemd/system/nvfd.service
        systemctl daemon-reload
    ' >/dev/null 2>&1 || true
fi
exit 0
